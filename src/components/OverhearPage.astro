---
interface Props {
  data: {
    name: string;
    site?: string;
    appStore?: string;
    // Read by the download section; omitted, the button is not rendered.
    downloadUrl?: string;
    version: string;
  };
}
const { data } = Astro.props;
const appStore = data.appStore ?? data.site ?? 'https://apps.apple.com/us/app/overhear-meetings/id6781855070?mt=12';
// The source is private, so nothing links to it: a 404 is a worse destination
// than no link. Public support routes are used instead.
const privacy = 'https://keithah.github.io/overhear/privacy.html';
// Public TestFlight link, for early builds ahead of the App Store release.
const testflight = 'https://testflight.apple.com/join/d7cA4a98';
const supportEmail = 'mailto:keith+overhear@hadm.net';
---

<div class="ps-page ps-display oh-page">
  <nav class="ps-subnav" aria-label="Overhear sections">
    <a href="#top" class="ps-brand" aria-label="Overhear home">
      <img src="/products/overhear/app-icon.png" alt="" width="26" height="26" />
      <strong>Overhear</strong>
    </a>
    <span class="ps-subnav-links">
      <a href="#features">Features</a>
      <a href="#calendars">Calendars</a>
      <a href="#privacy">Privacy</a>
      <a href="#download">Download</a>
      <a href="#support">Support</a>
    </span>
  </nav>

  <section id="top" class="ps-hero oh-hero" aria-labelledby="overhear-title">
    <div class="ps-hero-copy">
      <p class="ps-eyebrow"><span aria-hidden="true"></span> Free on the Mac App Store</p>
      <h1 id="overhear-title">Your next meeting, <em>one click away.</em></h1>
      <p class="ps-lede">
        Overhear sits in your Mac's menu bar, shows what's coming up today, and opens the right
        meeting in the right app when it's time. No account, no tracking, and nothing leaves your Mac.
      </p>
      <div class="ps-actions">
        <a class="ps-btn ps-primary" href={appStore} target="_blank" rel="noopener">Mac App Store</a>
        <a class="ps-btn ps-ghost" href={privacy} target="_blank" rel="noopener">Privacy</a>
      </div>
      <p class="ps-release-note">
        Free &middot; macOS 14 or later &middot; a tiny 2.1 MB download &middot; no data collected.
      </p>
    </div>
    <div class="oh-hero-capture" aria-label="Overhear meeting list and detail panel">
      <img
        class="oh-shot-list"
        src="/products/overhear/meeting-list.png"
        alt="Overhear meeting list with a NOW divider, NEXT badge, platform icons for Zoom, Teams and Meet, and Join buttons."
        width="760"
        height="1040"
        decoding="async"
        fetchpriority="high"
      />
      <img
        class="oh-shot-detail"
        src="/products/overhear/meeting-detail.png"
        alt="Overhear meeting detail panel showing time, organizer, participants and invite notes."
        width="760"
        height="1040"
        loading="lazy"
        decoding="async"
      />
      <div class="oh-menubar" aria-label="Example menu bar item">
        <span>Thu 2:29 PM</span>
        <strong>Design Review</strong>
        <em>in 1m</em>
      </div>
    </div>
  </section>

  <section id="features" class="ps-section oh-features" aria-labelledby="oh-features-title">
    <div class="ps-section-head">
      <p class="ps-index">01 / Features</p>
      <div>
        <h2 id="oh-features-title">Stop hunting for <em>the link.</em></h2>
      </div>
      <p>
        Finding the invite, checking the time, wondering which app it opens in &mdash; Overhear
        handles all of it. Your next meeting is always in the menu bar, one click from joining.
      </p>
    </div>
    <div class="ps-feature-grid oh-feature-grid">
      <article class="ps-card">
        <span>01</span>
        <h3>See what's next</h3>
        <p>Your next meeting and how long until it starts, right in the menu bar. Sharing your screen? Switch to a plain "Meeting" label and keep the title to yourself.</p>
      </article>
      <article class="ps-card">
        <span>02</span>
        <h3>Join in one click</h3>
        <p>Join from the menu bar, your meeting list, a reminder or a keyboard shortcut. Zoom, Google Meet, Teams, Webex and dozens more open straight in their own apps.</p>
      </article>
      <article class="ps-card">
        <span>03</span>
        <h3>Know before you join</h3>
        <p>See the time, who's hosting, who's invited and the notes from the invite. Copy the link or open the event in Calendar.</p>
      </article>
      <article class="ps-card">
        <span>04</span>
        <h3>Reminders you can snooze</h3>
        <p>A heads-up before each meeting, with snooze right beside join. If you like, Overhear can join for you the moment a meeting starts.</p>
      </article>
    </div>
    <figure class="oh-reminder">
      <figcaption>
        <span>Reminders</span>
        <strong>A clear heads-up, with snooze right beside join.</strong>
      </figcaption>
      <img
        src="/products/overhear/reminders.png"
        alt="Overhear reminder cards showing the meeting platform icon, start time, and Join with a Snooze button."
        width="808"
        height="636"
        loading="lazy"
        decoding="async"
      />
    </figure>
  </section>

  <section id="calendars" class="ps-section oh-calendars" aria-labelledby="oh-calendars-title">
    <div class="ps-section-head">
      <p class="ps-index">02 / Calendars</p>
      <div>
        <h2 id="oh-calendars-title">Works with the calendars <em>you already have.</em></h2>
      </div>
      <p>
        Overhear shows the calendars already set up on your Mac. Would rather not add an account
        to your Mac? Paste in the calendar's link instead.
      </p>
    </div>
    <div class="oh-calendar-grid">
      <figure class="oh-calendar-shot">
        <img
          src="/products/overhear/settings-calendars.png"
          alt="Overhear Settings on the Calendars pane, choosing calendars and which events to include."
          width="1520"
          height="1120"
          loading="lazy"
          decoding="async"
        />
        <figcaption><span>Settings &middot; Calendars</span> Choose which calendars appear, whether to show tentative, declined and all-day events, and hide meetings by title.</figcaption>
      </figure>
      <dl class="oh-calendar-list">
        <div>
          <dt>Add a calendar with a link</dt>
          <dd>Paste the calendar link from Google, Outlook, Fastmail or iCloud. Overhear checks that it works, shows how many events are coming up, and refreshes every 15 minutes.</dd>
        </div>
        <div>
          <dt>No duplicates</dt>
          <dd>If the same meeting is on two calendars, you see it once. Want every copy? You can turn that off.</dd>
        </div>
        <div>
          <dt>A colour for each calendar</dt>
          <dd>Give every calendar its own colour, so you can tell work from personal at a glance.</dd>
        </div>
        <div>
          <dt>Good to know</dt>
          <dd>Google can take a few hours to update a calendar link. If you need changes to show up within minutes, add the account in System Settings &rarr; Internet Accounts instead.</dd>
        </div>
      </dl>
    </div>
  </section>

  <section id="privacy" class="ps-section oh-privacy" aria-labelledby="oh-privacy-title">
    <div class="oh-privacy-panel">
      <div>
        <p class="ps-index">03 / Privacy</p>
        <h2 id="oh-privacy-title">Your calendar <em>stays yours.</em></h2>
        <p>
          Overhear reads your calendars on your Mac and sends nothing anywhere. Its App Store
          privacy label is <strong>Data Not Collected</strong>. Calendar links are locked away in
          your Mac's Keychain, and your meeting names never end up in system logs.
        </p>
      </div>
      <dl class="oh-facts">
        <div><dt>Account</dt><dd>None</dd></div>
        <div><dt>Tracking</dt><dd>None</dd></div>
        <div><dt>Price</dt><dd>Free</dd></div>
        <div><dt>Size</dt><dd>2.1 MB</dd></div>
      </dl>
    </div>
  </section>

  <section id="download" class="ps-section oh-download" aria-labelledby="oh-download-title">
    <div class="ps-download-panel">
      <div>
        <p class="ps-index">04 / Download</p>
        <h2 id="oh-download-title">Set it up once. <em>Forget it's there.</em></h2>
        <p>
          Free on the Mac App Store for macOS 14 or later. Would rather skip the store? Download
          it directly &mdash; it keeps itself up to date. Want new features early? Join the
          TestFlight beta.
        </p>
        <div class="ps-actions">
          <a class="ps-btn ps-primary" href={appStore} target="_blank" rel="noopener">Mac App Store</a>
          {data.downloadUrl && (
            <a class="ps-btn" href={data.downloadUrl} download>Direct download</a>
          )}
          <a class="ps-btn" href={testflight} target="_blank" rel="noopener">Join the TestFlight</a>
          <a class="ps-btn" href={privacy} target="_blank" rel="noopener">Privacy policy</a>
        </div>
      </div>
      <dl class="ps-release-box">
        <dt>Requires</dt>
        <dd>macOS 14.0+</dd>
        <dt>Category</dt>
        <dd>Productivity</dd>
        <dt>Languages</dt>
        <dd>English</dd>
        <dt>Age rating</dt>
        <dd>4+</dd>
      </dl>
    </div>
  </section>

  <section id="support" class="ps-section oh-support" aria-labelledby="oh-support-title">
    <div class="ps-support-grid">
      <div>
        <h2 id="oh-support-title">Need a <em>hand?</em></h2>
        <p>
          Send an email with your macOS version, the meeting service you were using, and what you
          expected to happen. Overhear is made by one person, so the more detail you share, the
          faster the fix.
        </p>
      </div>
      <div class="ps-actions">
        <a class="ps-btn ps-primary" href={supportEmail}>Email support</a>
        <a class="ps-btn" href={appStore} target="_blank" rel="noopener">Mac App Store</a>
      </div>
    </div>
  </section>
</div>
